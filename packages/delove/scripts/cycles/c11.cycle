# Cycle 11, run with (from the repo root; RUNPOD_API_KEY in the environment):
#   DELOVE_BRANCH_RANKER=delove@7 DELOVE_BRANCH_TEACHER=<jacob-sensei@2, or @1 if #144 is not merged> DELOVE_BRANCH_HORIZON=1
#   DELOVE_BRANCH_MARGIN=0.01 DELOVE_BRANCH_OPTIONS=5 REMOTE_GPUS=10 REMOTE_MAX_GPU_HOURS=9
#   REMOTE_TIMINGS="<runs>/c10/a1/gpu.log ... <runs>/c10/b/gpu.log"
#   DELOVE_MODELS=<models> DATA=<data> OUT=<runs>/c11 PYTHON=<venv python>
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c11.cycle
# Cycle 10's recipe one step on: delove@7 ranks the search's options and fills the network seats with delove@6; the
# search scores 5 options (research plan). Base model only: cycle 10's specialists were even with the base, so they
# wait for cycle 12's soft-target comparison (no stage games or specialists this cycle). The pod steps also write
# branch_q.npy (#145), kept for cycle 12's soft targets and unused here.
name=c11
seed=311
steps=(
  "a1 packages/delove/scripts/cycles/c11-a1.jobs Cycle 11, step a1: Classic 4-player"
  "a2 packages/delove/scripts/cycles/c11-a2.jobs Cycle 11, step a2: Classic 2p, Four Crowns 1v1, Classic 6p"
  "a3 packages/delove/scripts/cycles/c11-a3.jobs Cycle 11, step a3: Europe 8p, USA 10p, Asia 8p"
  "a4 packages/delove/scripts/cycles/c11-a4.jobs Cycle 11, step a4: Bohemia, Nine Realms, World 6p"
  "b packages/delove/scripts/cycles/c11-b.jobs Cycle 11, step b: the huge boards"
)
gpu_steps=(all)
export_agents=delove-branch@1
train_data=(a1/classic a2/classic a2/skirmish a3/europe a3/usa a3/asia a4/bohemia a4/nine_realms a4/world
  b/world b/world_large b/greater_europe b/fantasy b/europe_classic
  "c10-a1/classic#0.4" "c10-a2/classic#0.4" "c10-a2/skirmish#0.4" "c10-a3/europe#0.4" "c10-a3/usa#0.4" "c10-a3/asia#0.4"
  "c10-a4/bohemia#0.4" "c10-a4/nine_realms#0.4" "c10-a4/world#0.4" "c10-b/world#0.4" "c10-b/world_large#0.4"
  "c10-b/greater_europe#0.4" "c10-b/fantasy#0.4" "c10-b/europe_classic#0.4"
  "c9-a1/classic#0.2" "c9-a2/classic#0.2" "c9-a3/europe#0.2" "c9-a4/bohemia#0.2" "c9-b/world#0.2" "c9-b/greater_europe#0.2")
train_init=delove@7
candidate=c11-candidate
train_args="--epochs 1.5 --batch 512 --lr 2e-4 --hidden 192 --rounds 6 --value-target points --amp --branch-weights 0.5,1,2"
gates=(
  "delove@7 2 800"
  "delove@7 4 200"
  "delove@7 6 200"
  "delove@7 6 200 {\"map\":\"world\"}"
  "delove@7 10 200 {\"map\":\"world\"}"
  "delove@7 6 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\",\"capitals\":true,\"blizzards\":8}"
  "delove@7 6 200 {\"map\":\"world\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "delove@7 4 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@7 2 400 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@7 6 200 {\"map\":\"bohemia\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\"}"
  "delove@7 8 200 {\"map\":\"nine_realms\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "jacob-sensei@1 6 200 {\"map\":\"world\"}"
  "delove-teacher@2 2 400"
)
