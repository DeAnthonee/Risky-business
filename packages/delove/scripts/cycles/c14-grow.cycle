# Cycle 14, candidate (b): c14.cycle's games and data, trained with --grow-rounds 8 (#161: delove@10 grown from 6 to 8
# message-passing rounds, the new rounds starting as pass-throughs) and gated the same way. Run after c14.cycle's games
# are in, with OUT=<runs>/c14-grow holding copies of <runs>/c14/<step> folders and no REMOTE_GPUS:
#   for s in a1 a2 a3 a4 b; do cp -r <runs>/c14/$s <runs>/c14-grow/; done
#   GATE_SPRT=1 PANEL=1 DELOVE_MODELS=<models> DATA=<data> OUT=<runs>/c14-grow PYTHON=<venv python>
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c14-grow.cycle
name=c14
seed=314
steps=(
  "a1 packages/delove/scripts/cycles/c14-a1.jobs Cycle 14, step a1: Classic 4-player"
  "a2 packages/delove/scripts/cycles/c14-a2.jobs Cycle 14, step a2: Classic 2p, Four Crowns 1v1, Classic 6p"
  "a3 packages/delove/scripts/cycles/c14-a3.jobs Cycle 14, step a3: Europe 8p, USA 10p, Asia 8p"
  "a4 packages/delove/scripts/cycles/c14-a4.jobs Cycle 14, step a4: Bohemia, Nine Realms, World 6p"
  "b packages/delove/scripts/cycles/c14-b.jobs Cycle 14, step b: the huge boards"
)
gpu_steps=(all)
export_agents=delove-branch@1,delove-branch@1:range
train_data=(a1/classic a2/classic a2/skirmish a3/europe a3/usa a3/asia a4/bohemia a4/nine_realms a4/world
  b/world b/world_large b/greater_europe b/fantasy b/europe_classic
  "c13-a1/classic#0.4" "c13-a2/classic#0.4" "c13-a2/skirmish#0.4" "c13-a3/europe#0.4" "c13-a3/usa#0.4" "c13-a3/asia#0.4"
  "c13-a4/bohemia#0.4" "c13-a4/nine_realms#0.4" "c13-a4/world#0.4" "c13-b/world#0.4" "c13-b/world_large#0.4"
  "c13-b/greater_europe#0.4" "c13-b/fantasy#0.4" "c13-b/europe_classic#0.4"
  "c12-a1/classic#0.2" "c12-a2/classic#0.2" "c12-a3/europe#0.2" "c12-a4/bohemia#0.2" "c12-b/world#0.2" "c12-b/greater_europe#0.2")
train_init=delove@10
candidate=c141-candidate  # [rc]N-candidate: the agent registry loads only these names
train_args="--epochs 1.5 --batch 512 --lr 2e-4 --hidden 192 --rounds 6 --value-target points --amp --branch-weights 0.5,1,2 --grow-rounds 8"
gates=(
  "delove@10 2 800"
  "delove@10 4 200"
  "delove@10 6 200"
  "delove@10 6 200 {\"map\":\"world\"}"
  "delove@10 10 200 {\"map\":\"world\"}"
  "delove@10 6 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\",\"capitals\":true,\"blizzards\":8}"
  "delove@10 6 200 {\"map\":\"world\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "delove@10 4 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@10 2 400 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@10 6 200 {\"map\":\"bohemia\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\"}"
  "delove@10 8 200 {\"map\":\"nine_realms\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "jacob-sensei@1 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 2 400"
  "delove-teacher@2 2 400"
)
