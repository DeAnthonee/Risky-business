# Cycle 15, candidate (b): c15.cycle's games, data and fog dropout plus the Zerg-horde games at 0.3 (DATA/c15-horde,
# horde.jobs played with generate.sh and exported for delove-branch@1:range-horde), gated the same way. Run after
# c15.cycle's games are in, with OUT=<runs>/c15-horde holding copies of <runs>/c15/<step> folders and no REMOTE_GPUS:
#   for s in a1 a2 a3 a4 b; do cp -r <runs>/c15/$s <runs>/c15-horde/; done
#   GATE_SPRT=1 PANEL=1 DELOVE_MODELS=<models> DATA=<data> OUT=<runs>/c15-horde PYTHON=<venv python>
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c15-horde.cycle
name=c15
seed=315
steps=(
  "a1 packages/delove/scripts/cycles/c15-a1.jobs Cycle 15, step a1: Classic 4-player"
  "a2 packages/delove/scripts/cycles/c15-a2.jobs Cycle 15, step a2: Classic 2p, Four Crowns 1v1, Classic 6p"
  "a3 packages/delove/scripts/cycles/c15-a3.jobs Cycle 15, step a3: Europe 8p, USA 10p, Asia 8p"
  "a4 packages/delove/scripts/cycles/c15-a4.jobs Cycle 15, step a4: Bohemia, Nine Realms, World 6p"
  "b packages/delove/scripts/cycles/c15-b.jobs Cycle 15, step b: the huge boards"
)
gpu_steps=(all)
export_agents=delove-branch@1,delove-branch@1:range
train_data=(a1/classic a2/classic a2/skirmish a3/europe a3/usa a3/asia a4/bohemia a4/nine_realms a4/world
  b/world b/world_large b/greater_europe b/fantasy b/europe_classic
  "c14-a1/classic#0.4" "c14-a2/classic#0.4" "c14-a2/skirmish#0.4" "c14-a3/europe#0.4" "c14-a3/usa#0.4" "c14-a3/asia#0.4"
  "c14-a4/bohemia#0.4" "c14-a4/nine_realms#0.4" "c14-a4/world#0.4" "c14-b/world#0.4" "c14-b/world_large#0.4"
  "c14-b/greater_europe#0.4" "c14-b/fantasy#0.4" "c14-b/europe_classic#0.4"
  "c13-a1/classic#0.2" "c13-a2/classic#0.2" "c13-a3/europe#0.2" "c13-a4/bohemia#0.2" "c13-b/world#0.2" "c13-b/greater_europe#0.2"
  "c15-horde/classic#0.3")
train_init=delove@11
candidate=c151-candidate  # [rc]N-candidate: the agent registry loads only these names
train_args="--epochs 1.5 --batch 512 --lr 2e-4 --hidden 192 --rounds 6 --value-target points --amp --branch-weights 0.5,1,2 --fog-dropout 0.25"
gates=(
  "delove@11 2 800"
  "delove@11 4 200"
  "delove@11 6 200"
  "delove@11 6 200 {\"map\":\"world\"}"
  "delove@11 10 200 {\"map\":\"world\"}"
  "delove@11 6 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\",\"capitals\":true,\"blizzards\":8}"
  "delove@11 6 200 {\"map\":\"world\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "delove@11 4 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@11 2 400 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@11 6 200 {\"map\":\"bohemia\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\"}"
  "delove@11 8 200 {\"map\":\"nine_realms\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "jacob-sensei@1 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 2 400"
  "delove-teacher@2 2 400"
)
