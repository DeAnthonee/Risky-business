# Cycle 18, run with (from the repo root; RUNPOD_API_KEY in the environment):
#   DELOVE_BRANCH_RANKER=delove@13 DELOVE_BRANCH_TEACHER=jacob-sensei@2 DELOVE_BRANCH_HORIZON=1
#   DELOVE_BRANCH_MARGIN=0.01 DELOVE_BRANCH_OPTIONS=5 REMOTE_GPUS=7 REMOTE_MAX_GPU_HOURS=8.4
#   REMOTE_TRAIN=1 REMOTE_VOLUME=<volume id> REMOTE_HOME_COPY=1 REMOTE_TRAIN_DISK_GB=250 GATE_SPRT=1 PANEL=1
#   REMOTE_TIMINGS="<runs>/c17/a1/gpu.log ... <runs>/c17/b/gpu.log"
#   DELOVE_MODELS=<models> DATA=<data> OUT=<runs>/c18 PYTHON=<venv python>
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c18.cycle
# Cycle 17's base and teacher with the search back to 5 options everywhere (6 did not help in cycle 17): delove@13
# ranks the search and fills the network seats with delove@13 / delove@12, Jacob Sensei 2 rollouts, range-scored branch
# seats at 6-10p. One candidate from delove@13, --fog-dropout 0.25, on cycle 18 + cycle 17 (its 6-option games) at 0.6 +
# cycle 16 at 0.4, trained on a rented pod from the network volume. The fog-on gate decides (c18-fog.cycle).
# New with the verified fingerprint of #278: hexworld (Hex Earth) replaces the World 6p / 10p and World Large tables
# (hx6a-hx10d, 3,500 games, about 9%), and the 2-player tables use the Gumbel root (delove-branch@1:range:gumbel, #187).
name=c18
seed=318
steps=(
  "a1 packages/delove/scripts/cycles/c18-a1.jobs Cycle 18, step a1: Classic 4-player"
  "a2 packages/delove/scripts/cycles/c18-a2.jobs Cycle 18, step a2: Classic 2p, Four Crowns 1v1, Classic 6p"
  "a3 packages/delove/scripts/cycles/c18-a3.jobs Cycle 18, step a3: Europe 8p, USA 10p, Asia 8p"
  "a4 packages/delove/scripts/cycles/c18-a4.jobs Cycle 18, step a4: Bohemia, Nine Realms, Hex Earth 6p"
  "b packages/delove/scripts/cycles/c18-b.jobs Cycle 18, step b: the huge boards"
)
gpu_steps=(all)
export_agents=delove-branch@1,delove-branch@1:range,delove-branch@1:range:gumbel
train_data=(a1/classic a2/classic a2/skirmish a3/europe a3/usa a3/asia a4/bohemia a4/nine_realms a4/hexworld b/hexworld b/greater_europe b/fantasy b/europe_classic
  "c17-a1/classic#0.6" "c17-a2/classic#0.6" "c17-a2/skirmish#0.6" "c17-a3/europe#0.6" "c17-a3/usa#0.6" "c17-a3/asia#0.6" "c17-a4/bohemia#0.6" "c17-a4/nine_realms#0.6" "c17-a4/world#0.6" "c17-b/world#0.6" "c17-b/world_large#0.6" "c17-b/greater_europe#0.6" "c17-b/fantasy#0.6" "c17-b/europe_classic#0.6"
  "c16-a1/classic#0.4" "c16-a2/classic#0.4" "c16-a2/skirmish#0.4" "c16-a3/europe#0.4" "c16-a3/usa#0.4" "c16-a3/asia#0.4" "c16-a4/bohemia#0.4" "c16-a4/nine_realms#0.4" "c16-a4/world#0.4" "c16-b/world#0.4" "c16-b/world_large#0.4" "c16-b/greater_europe#0.4" "c16-b/fantasy#0.4" "c16-b/europe_classic#0.4")
train_init=delove@13
candidate=c18-candidate
train_args="--epochs 1.5 --batch 512 --lr 2e-4 --hidden 192 --rounds 6 --value-target points --amp --branch-weights 0.5,1,2 --fog-dropout 0.25"
gates=(
  "delove@13 2 800"
  "delove@13 4 200"
  "delove@13 6 200"
  "delove@13 6 200 {\"map\":\"world\"}"
  "delove@13 10 200 {\"map\":\"world\"}"
  "delove@13 6 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\",\"capitals\":true,\"blizzards\":8}"
  "delove@13 6 200 {\"map\":\"world\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "delove@13 4 200 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@13 2 400 {\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"exponential\",\"blizzards\":8}"
  "delove@13 6 200 {\"map\":\"bohemia\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"progressive\"}"
  "delove@13 8 200 {\"map\":\"nine_realms\",\"autoSetup\":true,\"balancedBlitz\":true,\"chooseCapitals\":true,\"cardValues\":\"fixed\",\"capitals\":true}"
  "jacob-sensei@1 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 6 200 {\"map\":\"world\"}"
  "jacob-sensei@2 2 400"
  "delove-teacher@2 2 400"
)
