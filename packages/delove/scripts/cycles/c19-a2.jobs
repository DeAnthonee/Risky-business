mcb 1800 delove-branch@1:range:gumbel,delove@13 {"map":"skirmish","autoSetup":true,"balancedBlitz":true,"chooseCapitals":true,"cardValues":"fixed","capitals":true}
c6a 600 jacob-sensei@1,delove@13,jacob-sensei@1,delove@12,jacob-sensei@1,delove-branch@1:range {"autoSetup":true,"balancedBlitz":true,"chooseCapitals":true,"cardValues":"exponential","blizzards":8}
