# Cycle 3, run with: DELOVE_BRANCH_RANKER=c2-candidate DELOVE_BRANCH_HORIZON=1 DELOVE_BRANCH_MARGIN=0.01 \
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c3.cycle
# Branch settings from the cycle 3 tests (2,000 games each against delove@2): horizon 1 scores as well as 2 (0.5675
# vs 0.561) at half the time, horizon 3 worse (0.529); blending the value head in does not help (0.5615 at 0.3).
name=c3
seed=303
steps=(
  "micro packages/delove/scripts/cycles/c3-micro.jobs Cycle 3, step 1: micro games (1v1, Four Crowns)"
  "classic2 packages/delove/scripts/cycles/c3-classic2.jobs Cycle 3, step 2: scenario games on Classic (2 players)"
  "classic4 packages/delove/scripts/cycles/c3-classic4.jobs Cycle 3, step 3: scenario games on Classic (4 players)"
)
export_agents=delove-branch@1
# Every branch-and-score decision so far, 2-player Classic weighted up, plus Sensei 2's 2-player games as an anchor.
train_data=(micro/skirmish classic2/classic*2 classic4/classic
  c2-micro/skirmish c2-classic2/classic c2-classic4/classic
  c1-micro/skirmish c1-classic2/classic c1-classic4/classic
  c2old-micro/skirmish c2old-classic2/classic
  r05-sensei2/classic)
train_init=c2-candidate
candidate=c3-candidate
train_args="--epochs 1 --lr 3e-4"
gates=(
  "delove@2 2 800"
  "delove@2 4 200"
  "delove@2 6 200"
  "delove@2 2 200 {\"map\":\"skirmish\"}"
  "c2-candidate 2 400"
  "delove-teacher@2 2 200"
)
