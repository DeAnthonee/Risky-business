# Cycle 4, run with: DELOVE_BRANCH_RANKER=c3-candidate DELOVE_BRANCH_HORIZON=1 DELOVE_BRANCH_MARGIN=0.01 \
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c4.cycle
# Cycles 1-3 kept landing even with delove@2 at 2 players while the branch player beats it 0.56-0.57: the student
# matches the branch player's choices only 62-71% of the time. Cycle 4 tests capacity: a fresh, larger network
# (hidden 192, 6 rounds; delove@2 is 128 / 4) on every branch decision so far.
name=c4
seed=304
steps=(
  "micro packages/delove/scripts/cycles/c4-micro.jobs Cycle 4, step 1: micro games (1v1, Four Crowns)"
  "classic2 packages/delove/scripts/cycles/c4-classic2.jobs Cycle 4, step 2: scenario games on Classic (2 players)"
  "classic4 packages/delove/scripts/cycles/c4-classic4.jobs Cycle 4, step 3: scenario games on Classic (4 players)"
)
export_agents=delove-branch@1
train_data=(micro/skirmish classic2/classic*2 classic4/classic
  c3-micro/skirmish c3-classic2/classic*2 c3-classic4/classic
  c2-micro/skirmish c2-classic2/classic c2-classic4/classic
  c1-micro/skirmish c1-classic2/classic c1-classic4/classic
  c2old-micro/skirmish c2old-classic2/classic
  r05-sensei2/classic)
train_init=
candidate=c4-candidate
train_args="--epochs 2 --lr 1e-3 --hidden 192 --rounds 6"
gates=(
  "delove@2 2 800"
  "delove@2 4 200"
  "delove@2 6 200"
  "delove@2 2 200 {\"map\":\"skirmish\"}"
  "c3-candidate 2 400"
  "delove-teacher@2 2 200"
)
