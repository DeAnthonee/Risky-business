# Cycle 5, run with (from the repo root):
#   DELOVE_BRANCH_RANKER=delove@3 DELOVE_BRANCH_HORIZON=1 DELOVE_BRANCH_MARGIN=0.01 GPU_GB=6 \
#   DELOVE_MODELS=<models> DATA=<data> OUT=<runs>/c5 PYTHON=<venv python> \
#   bash packages/delove/scripts/cycle.sh packages/delove/scripts/cycles/c5.cycle
# The first big, all-maps cycle: about 5x cycle 4's games, most of them on the GPU, trained on leaderboard points
# (--value-target points). New: multiplayer tables of 4-10 seats on World, Greater Europe, Europe, USA, Asia and
# Fantasy, and Classic 6p. Seats: the branch player against Sensei 2 (delove-teacher@2), delove@3 and delove@2.
# Greater Europe plays 2-player tables only: 118 of 128 pilot games at 10 seats and 150 of 255 at 4 seats hit the
# turn limit (Sensei 2 stalls; see CYCLES.md).
# The GPU plays Classic 2-player and the big tables (each configuration's games at once, sized by GPU_GB); the CPU
# pool plays Four Crowns and Classic 4-player meanwhile.
name=c5
seed=305
steps=(
  "big packages/delove/scripts/cycles/c5-big.jobs Cycle 5, step 4: big tables on seven maps (2-10 players)"
  "classic2 packages/delove/scripts/cycles/c5-classic2.jobs Cycle 5, step 2: scenario games on Classic (2 players)"
  "micro packages/delove/scripts/cycles/c5-micro.jobs Cycle 5, step 1: micro games (1v1, Four Crowns)"
  "classic4 packages/delove/scripts/cycles/c5-classic4.jobs Cycle 5, step 3: scenario games on Classic (4 players)"
)
gpu_steps=(big classic2)
export_agents=delove-branch@1
train_data=(micro/skirmish classic2/classic classic4/classic
  big/world big/greater_europe big/europe big/usa big/asia big/fantasy big/classic
  c4-micro/skirmish c4-classic2/classic c4-classic4/classic
  c3-micro/skirmish c3-classic2/classic c3-classic4/classic
  c2-micro/skirmish c2-classic2/classic c2-classic4/classic
  c1-micro/skirmish c1-classic2/classic c1-classic4/classic
  c2old-micro/skirmish c2old-classic2/classic
  r05-sensei2/classic)
train_init=delove@3
candidate=c5-candidate
train_args="--epochs 2 --batch 512 --lr 3e-4 --hidden 192 --rounds 6 --value-target points"
gates=(
  "delove@3 2 800"
  "delove@3 4 200"
  "delove@3 6 200"
  "delove@3 10 200 {\"map\":\"world\"}"
  "delove@3 2 400 {\"map\":\"skirmish\"}"
  "delove@3 6 200 {\"map\":\"world\"}"
  "delove@3 10 200 {\"map\":\"greater_europe\"}"
  "delove-teacher@2 2 400"
  "delove@2 2 400"
)
